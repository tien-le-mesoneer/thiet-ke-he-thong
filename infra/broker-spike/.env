# Caps for the spike. Defaults in compose.yaml are 1g each (headroom for
# measuring); these are the ADR's sized values.
#
# Measured floors that survive a 200k-event run without an OOM kill:
#   kafka    512m + -Xmx256m  -> peaked at 430.3MB = 84% of cap (too thin)
#   rabbitmq 256m             -> peaked at 175.9MB = 69% of cap
#
# Kafka therefore gets 768m, matching how the Node apps were sized (256m for a
# 155MB peak). The JVM heap must be set separately -- mem_limit is invisible
# to it, same trap as WiredTiger.
MEM_KAFKA=768m
KAFKA_HEAP=384m
MEM_RABBIT=256m
