# Host-side ports for the observability stack.
#
# All published on the 7xxx block so nothing collides with the usual suspects
# (3000 Grafana, 9090 Prometheus, 4317/4318 OTLP, 5000/7000 macOS AirPlay).
# Each keeps its upstream default's digits, so the mapping stays memorable:
#
#   Grafana      3000  -> 7080     Prometheus   9090  -> 7090
#   Tempo        3200  -> 7200     OTLP gRPC    4317  -> 7317
#   OTLP HTTP    4318  -> 7318     Collector health 13133 -> 7133
#   App metrics  8889  -> 7889     Self metrics 8888  -> 7888 (not published)
#
# Container-INTERNAL ports are unchanged; only the host side is remapped, so
# every upstream config, dashboard, and scrape target keeps its default.

OBS_GRAFANA_PORT=7080
OBS_PROMETHEUS_PORT=7090
OBS_TEMPO_PORT=7200
OBS_OTLP_GRPC_PORT=7317
OBS_OTLP_HTTP_PORT=7318
OBS_COLLECTOR_HEALTH_PORT=7133
OBS_COLLECTOR_METRICS_PORT=7889
